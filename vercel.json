{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "codex/production-backup-recovery-20261022": false,
      "codex/backup67-sandbox-proof-20261023": false
    }
  },
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|json|ico|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}
