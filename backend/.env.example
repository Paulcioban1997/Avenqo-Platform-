APP_NAME=Avenqo
APP_VERSION=0.1.0
APP_DESCRIPTION=Enterprise-grade SaaS AI Platform foundation
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
DATABASE_URL=sqlite:///./var/avenqo.db
ARTIFACT_ROOT=var/artifacts
DATASET_MAX_UPLOAD_MB=50
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AUTH_ACCESS_MINUTES=15
AUTH_REFRESH_DAYS=30
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=avenqo-api
AUTH_JWT_AUDIENCE=avenqo-clients
FRONTEND_URL=http://localhost:8080
# Production Railway: use https_api. Keep the API key in the deployment secret manager.
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM_EMAIL=noreply@avenqo.ca
EMAIL_FROM_NAME=Avenqo
# Optional legacy SMTP transport for compatible local/development environments.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@avenqo.ca
AVENQO_OWNER_NOTIFICATION_EMAIL=
SMTP_USE_TLS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEMO=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_CREDIT_DEMO=
# Legacy alias for the Professional 25,000-credit pack.
STRIPE_PRICE_CREDIT_PROFESSIONAL=
STRIPE_PRICE_CREDIT_PROFESSIONAL_6500=
STRIPE_PRICE_CREDIT_PROFESSIONAL_25000=
# Commerce connector credentials remain backend-only. Generate each Fernet key
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Put the active key first; comma-separate older keys during rotation.
CONNECTOR_ENCRYPTION_KEYS=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/connectors/shopify/callback
SHOPIFY_WEBHOOK_URI=http://localhost:8000/api/v1/connectors/shopify/webhook
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,read_customers,read_products,read_inventory,read_locations
# Enterprise est sur devis et n'a pas de Price ID self-service.
# JSON. Aucune limite par défaut (non plafonné tant que non configuré).
# Voir docs/ai-usage-quotas.md. Ex: {"demo": {"monthly_ai_requests": 200}}
AI_QUOTA_LIMITS={}
# Politique de fraîcheur des modèles/prédictions (défaut technique, pas commercial).
# Voir docs/ai-predictive-copilot.md.
AI_FRESHNESS_STALE_AFTER_DAYS=7
AI_FRESHNESS_EXPIRED_AFTER_DAYS=30
AI_FRESHNESS_BLOCK_ON_EXPIRED=true
# Gateway IA résiliente (Phase 32). Voir docs/ai-support-and-provider-resilience.md.
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER_1=anthropic
AI_FALLBACK_PROVIDER_2=gemini
AI_GATEWAY_MAX_RETRIES=2
AI_GATEWAY_BASE_DELAY_SECONDS=0.5
AI_GATEWAY_MAX_DELAY_SECONDS=4.0
AI_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
AI_GATEWAY_CIRCUIT_COOLDOWN_SECONDS=30.0
# Conversion économique et tarifs par modèle. AI_MODEL_RATE_CARD accepte un objet JSON
# indexé par "provider:model", modèle ou provider; les valeurs remplacent le barème par défaut.
AVENQO_PROVIDER_COST_PER_CREDIT_USD=0.00030
AI_CREDIT_RESERVATION_TTL_MINUTES=1440
AI_MODEL_RATE_CARD={}
AI_SUPPORT_KNOWLEDGE_ROOT=platform_knowledge
# Bootstrap sécurisé du platform_admin propriétaire — voir docs/platform-admin-setup.md.
# Ne jamais committer de vraies valeurs ici (fichier .env.example uniquement).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
