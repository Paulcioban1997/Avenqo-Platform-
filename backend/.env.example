APP_NAME=PMC Solutions AI Platform
APP_VERSION=0.1.0
APP_DESCRIPTION=Enterprise-grade SaaS AI Platform foundation
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
DATABASE_URL=sqlite:///./var/nexora.db
ARTIFACT_ROOT=var/artifacts
DATASET_MAX_UPLOAD_MB=50
AUTH_ACCESS_MINUTES=15
AUTH_REFRESH_DAYS=30
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=nexora-api
AUTH_JWT_AUDIENCE=nexora-clients
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nexora.ca
SMTP_USE_TLS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
