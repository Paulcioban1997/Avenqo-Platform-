FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
# Stdlib HTTP trigger only. No API image, ML, database client, volume or healthcheck.
COPY backend/app/services/commerce_reconciliation_cron_trigger.py backend/app/services/commerce_reconciliation_cron_trigger.py
COPY backend/app/services/scheduler_http.py backend/app/services/scheduler_http.py
USER 65532:65532
CMD ["python", "-m", "backend.app.services.commerce_reconciliation_cron_trigger"]
