# One-shot validation only. No API, active database connection, volume or public port.
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH="/usr/lib/postgresql/18/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl --fail https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-18 postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'boto3>=1.35.0' 'pydantic-settings>=2.6.0'
WORKDIR /srv
COPY backend/__init__.py backend/__init__.py
COPY backend/app/__init__.py backend/app/__init__.py
COPY backend/app/config/__init__.py backend/app/config/__init__.py
COPY backend/app/config/settings.py backend/app/config/settings.py
COPY backend/app/services/__init__.py backend/app/services/__init__.py
COPY backend/app/services/backup_service.py backend/app/services/backup_service.py
COPY scripts/validate_backup67_sandbox.py scripts/validate_backup67_sandbox.py
RUN useradd --create-home --shell /usr/sbin/nologin qa_runtime && chown -R qa_runtime:qa_runtime /srv
USER qa_runtime
CMD ["python", "scripts/validate_backup67_sandbox.py"]
