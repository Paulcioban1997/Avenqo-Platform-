{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m backend.app.services.commerce_reconciliation_cron_trigger",
    "cronSchedule": "*/15 * * * *",
    "restartPolicyType": "NEVER"
  }
}